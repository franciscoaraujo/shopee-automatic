# Copie para .env (Docker) ou .env.local (npm run dev) e preencha.
# Gere segredos com:  openssl rand -hex 32

# ---------- Segredos obrigatórios ----------
POSTGRES_PASSWORD=
# Chave que criptografa as credenciais dos clientes (64 caracteres hex).
# GUARDE UMA CÓPIA FORA DO SERVIDOR: sem ela, as credenciais salvas não podem ser lidas.
APP_MASTER_KEY=
# Chave global da Evolution API (WhatsApp)
EVOLUTION_API_KEY=
# Senha da área /admin (mínimo 8 caracteres)
ADMIN_PASSWORD=
# Opcional: segredo da sessão do admin
ADMIN_SESSION_SECRET=

# ---------- Site ----------
# Domínio público (usado pelo Caddy para emitir o HTTPS) e URL do site
DOMAIN=app.seudominio.com.br
NEXT_PUBLIC_SITE_URL=https://app.seudominio.com.br
# WhatsApp do suporte: DDI + DDD + número, só dígitos
NEXT_PUBLIC_WHATSAPP=5511999998888
NEXT_PUBLIC_CONTACT_EMAIL=contato@seudominio.com.br

# ---------- E-mail (confirmação de cadastro e recuperação de senha) ----------
# Qualquer SMTP: Brevo (smtp-relay.brevo.com:587), Resend (smtp.resend.com:465),
# Amazon SES, Gmail (smtp.gmail.com:587 com senha de app)…
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=AutoAchados <nao-responda@seudominio.com.br>
# Desenvolvimento: caixa local que captura os e-mails (http://localhost:8025)
# COMPOSE_PROFILES=mail-dev
# SMTP_HOST=mailpit
# SMTP_PORT=1025

# ---------- Opcionais ----------
# Cookies só por HTTPS (deixe true em produção; false apenas para testar via http://localhost)
COOKIE_SECURE=true
# Rodadas simultâneas por worker
WORKER_CONCURRENCY=4
# Porta/endereço do site no host (atrás do Caddy fica em 127.0.0.1)
WEB_HOST_BIND=127.0.0.1
WEB_HOST_PORT=3000

# ---------- Desenvolvimento (npm run dev, fora do Docker) ----------
# DATABASE_URL=postgres://autoachados:SENHA@localhost:5432/autoachados
# EVOLUTION_API_URL=http://localhost:8080
