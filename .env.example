# Copie para .env e preencha:  cp .env.example .env
#
# Este arquivo guarda SOMENTE segredos de infraestrutura, necessários para os
# containers iniciarem. As credenciais da Shopee, do Telegram e do WhatsApp são
# configuradas no painel (http://localhost:3100 -> Configurações) e ficam
# criptografadas no banco — não precisam (e não devem) ficar aqui.
#
# Gere valores aleatórios com:  openssl rand -hex 32

TZ=America/Sao_Paulo

# ---------- Portas no host (mude se alguma já estiver em uso) ----------
# Ao mudar EVOLUTION_HOST_PORT, ajuste também EVOLUTION_SERVER_URL abaixo.
N8N_HOST_PORT=5678
EVOLUTION_HOST_PORT=8080
DASHBOARD_HOST_PORT=3100

# ---------- n8n ----------
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=troque-por-uma-chave-aleatoria-longa

# ---------- Evolution API (WhatsApp) ----------
# Chave global do servidor Evolution (usada pelo painel e pelo n8n)
EVOLUTION_API_KEY=troque-esta-apikey
EVOLUTION_SERVER_URL=http://localhost:8080
# Opcional: força a versão do WhatsApp Web. Deixe vazio (detecção automática);
# só preencha se o QR Code não for gerado.
WA_WEB_VERSION=

# ---------- PostgreSQL (Evolution API + painel) ----------
POSTGRES_USER=evolution
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=evolution

# ---------- Painel (http://localhost:3100) ----------
# Token interno entre n8n e painel (eventos + leitura da configuração)
DASHBOARD_INGEST_TOKEN=troque-este-token
# Opcional: chave mestra AES-256 em hex (64 caracteres). Se vazia, o painel gera
# uma automaticamente e guarda no volume dashboard_data (faça backup dele).
CONFIG_MASTER_KEY=
# true quando o painel estiver publicado atrás de HTTPS
COOKIE_SECURE=false
# Opcional: lista execuções do n8n (n8n -> Settings -> n8n API -> Create an API key)
N8N_API_KEY=
N8N_WORKFLOW_ID=
# Minutos sem busca na Shopee até o painel sinalizar "Atenção"
SHOPEE_STALE_MINUTES=90

# ---------- Legado (opcional) ----------
# Só são usados se o campo correspondente ainda não tiver sido salvo no painel.
# Prefira configurar pelo painel e deixar estas linhas vazias.
# SHOPEE_APP_ID=
# SHOPEE_SECRET=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# EVOLUTION_INSTANCE=shopee
# WHATSAPP_GROUP_JID=
